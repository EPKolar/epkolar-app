# Caddy - EP Kolar Kamera-Gateway auf der QNAP (20.11.2026). Einziger Web-Eingang zu go2rtc.
# Wird von Chat-Claude auf der QNAP eingesetzt. KEINE Adressen in dieser Datei: die LAN-Adresse kommt aus der
# Umgebung {$QNAP_LAN_IP} (siehe ENV.md), der Port aus {$KAMERA_GATEWAY_PORT} (Standard 443; ist 443 auf der QNAP
# durch QTS belegt, z. B. 8443 setzen - dann KAMERA_GATEWAY_BASE = https://<QNAP-LAN-IP>:8443).
#
# go2rtc laeuft bereits auf der QNAP (Container Station, Host-Netz, API 127.0.0.1:1984). Caddy und kamera-auth
# laufen ebenfalls im Host-Netz (docker-compose.yml): Caddy spricht go2rtc ueber 127.0.0.1:1984 und den Pruefer
# ueber 127.0.0.1:{$KAMERA_AUTH_PORT}. Port 1984 darf im LAN NICHT erreichbar sein (QNAP-Firewall / go2rtc
# api.listen auf 127.0.0.1:1984) - sonst ginge jeder an Token und Betriebsvereinbarung vorbei.
#
# SICHERHEIT (aus tools/kamera-proxy-auth/vorlagen/Caddyfile uebernommen, NICHT entfernen):
#   - jede Route ist "handle { route { forward_auth ... ; rewrite ; reverse_proxy } }": forward_auth laeuft VOR
#     rewrite und reverse_proxy; weitergeleitet wird NUR nach 2xx von kamera-auth
#   - X-Forwarded-Uri / X-Forwarded-Method werden von Caddy auf die Originalanfrage UEBERSCHRIEBEN, Client-Kopien
#     X-Original-* entfernt (Pruefer: KAMERA_AUTH_URI_HEADER=x-forwarded-uri -> eingeschleuste X-Original-* = 403)
#   - /gesund ohne Bild; alles andere (auch go2rtc /api/*, Oberflaeche, Konfiguration) -> 404
#   - Zugriffsprotokoll ohne token/Cookie/Authorization; CORS nur fuer https://epkolar.github.io
# WebRTC-MEDIEN laufen NICHT durch Caddy: nach dem WHEP-Austausch verbindet sich der Browser direkt mit go2rtc
# (Port 8555 TCP+UDP auf der QNAP, im LAN erreichbar). Nur das WHEP-Angebot selbst geht ueber diesen Eingang.
# Pruefen vor dem Start:  docker compose run --rm caddy caddy validate --config /etc/caddy/Caddyfile

{
	admin off
	auto_https disable_redirects
}

https://{$QNAP_LAN_IP}:{$KAMERA_GATEWAY_PORT:443} {
	# ── TLS ohne DNS/IT: eigene Caddy-CA, Zertifikat fuer die IP. Stammzertifikat EINMAL auf jedem Geraet
	#    installieren (Datei im Volume caddy_daten: /data/caddy/pki/authorities/local/root.crt).
	tls internal
	# ── Alternative mit DNS (IT): Site-Adresse oben durch kameras.ep-kolar.at ersetzen und Zertifikat per DNS-01:
	#   kameras.ep-kolar.at {
	#   	tls /zertifikate/kamera.crt /zertifikate/kamera.key

	# ── Protokoll OHNE Tokens ───────────────────────────────────────────────────────────────
	log {
		output file /protokoll/zugriff.log {
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Kamera-Token delete
				resp_headers>Set-Cookie delete
				resp_headers>Location delete
			}
		}
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cache-Control "no-store"
	}

	# ── CORS-Vorabanfrage fuer WHEP (fetch POST application/sdp von https://epkolar.github.io) ─────
	@vorab {
		method OPTIONS
		path /live/*
	}
	handle @vorab {
		header Access-Control-Allow-Origin "https://epkolar.github.io"
		header Access-Control-Allow-Methods "POST, OPTIONS"
		header Access-Control-Allow-Headers "content-type"
		header Access-Control-Allow-Private-Network "true"
		header Access-Control-Max-Age "600"
		header Vary "Origin"
		respond 204
	}

	# ── WebRTC (WHEP) -> go2rtc /api/webrtc?src=<s> (G3: hochregal01, verkauf02, elektrolager03, cam39) ──
	@whep path_regexp whep ^/live/([A-Za-z0-9_-]{1,64})/whep$
	handle @whep {
		route {
			forward_auth 127.0.0.1:{$KAMERA_AUTH_PORT:9099} {
				uri /pruefen
				header_up -X-Original-URI
				header_up -X-Original-Method
				header_up X-Forwarded-Uri {http.request.orig_uri}
				header_up X-Forwarded-Method {http.request.orig_method}
				copy_headers X-Kamera-User X-Kamera-Stream
			}
			header Access-Control-Allow-Origin "https://epkolar.github.io"
			header Access-Control-Allow-Private-Network "true"
			header Vary "Origin"
			rewrite * /api/webrtc?src={re.whep.1}
			reverse_proxy 127.0.0.1:1984
		}
	}

	# ── MJPEG (Bild-Element) -> go2rtc /api/stream.mjpeg?src=<s> (Mobotix mob32..mob36, stream_typ mjpeg) ──
	@mjpeg path_regexp mjpeg ^/live/([A-Za-z0-9_-]{1,64})/mjpeg$
	handle @mjpeg {
		route {
			forward_auth 127.0.0.1:{$KAMERA_AUTH_PORT:9099} {
				uri /pruefen
				header_up -X-Original-URI
				header_up -X-Original-Method
				header_up X-Forwarded-Uri {http.request.orig_uri}
				header_up X-Forwarded-Method {http.request.orig_method}
				copy_headers X-Kamera-User X-Kamera-Stream
			}
			rewrite * /api/stream.mjpeg?src={re.mjpeg.1}
			reverse_proxy 127.0.0.1:1984 {
				flush_interval -1
			}
		}
	}

	# ── Einzelbild (Rueckfall der App bei WHEP-/ICE-Fehler) -> go2rtc /api/frame.jpeg?src=<s> ─────────────
	@bild path_regexp bild ^/live/([A-Za-z0-9_-]{1,64})/snapshot\.jpg$
	handle @bild {
		route {
			forward_auth 127.0.0.1:{$KAMERA_AUTH_PORT:9099} {
				uri /pruefen
				header_up -X-Original-URI
				header_up -X-Original-Method
				header_up X-Forwarded-Uri {http.request.orig_uri}
				header_up X-Forwarded-Method {http.request.orig_method}
				copy_headers X-Kamera-User X-Kamera-Stream
			}
			rewrite * /api/frame.jpeg?src={re.bild.1}
			reverse_proxy 127.0.0.1:1984
		}
	}

	# ── HLS-Rueckfall: Playlist mit Token -> go2rtc /api/stream.m3u8?src=<s> ───────────────────────────────
	# go2rtc verweist relativ auf hls/playlist.m3u8?id=..., hls/segment.ts|.m4s, hls/init.mp4. Die laedt der
	# Browser OHNE Query-Token nach -> nach gepruefter Playlist setzt Caddy das (bereits gepruefte) Token als Cookie
	# kam_t, nur fuer /live/<s>/, hoechstens 120 s (= laengste Token-Laufzeit; der Pruefer prueft exp bei JEDEM Teil).
	# Grenze: Safari/iOS blockiert Dritt-Cookies -> dort scheitern die Teile (die App nutzt WHEP + Einzelbild).
	@hls path_regexp hls ^/live/([A-Za-z0-9_-]{1,64})/index\.m3u8$
	handle @hls {
		route {
			forward_auth 127.0.0.1:{$KAMERA_AUTH_PORT:9099} {
				uri /pruefen
				header_up -X-Original-URI
				header_up -X-Original-Method
				header_up X-Forwarded-Uri {http.request.orig_uri}
				header_up X-Forwarded-Method {http.request.orig_method}
				copy_headers X-Kamera-User X-Kamera-Stream
			}
			header Set-Cookie "kam_t={http.request.uri.query.token}; Path=/live/{re.hls.1}/; Max-Age=120; HttpOnly; Secure; SameSite=None"
			rewrite * /api/stream.m3u8?src={re.hls.1}
			reverse_proxy 127.0.0.1:1984
		}
	}

	# ── HLS-Teile (Cookie kam_t, vom Pruefer gegen Stream + Ablauf geprueft) -> go2rtc /api/hls/<teil>?id=... ──
	@hlsteil path_regexp hlsteil ^/live/([A-Za-z0-9_-]{1,64})/hls/([A-Za-z0-9_-][A-Za-z0-9._-]{0,127})$
	handle @hlsteil {
		route {
			forward_auth 127.0.0.1:{$KAMERA_AUTH_PORT:9099} {
				uri /pruefen
				header_up -X-Original-URI
				header_up -X-Original-Method
				header_up X-Forwarded-Uri {http.request.orig_uri}
				header_up X-Forwarded-Method {http.request.orig_method}
				copy_headers X-Kamera-User X-Kamera-Stream
			}
			rewrite * /api/hls/{re.hlsteil.2}?id={http.request.uri.query.id}
			reverse_proxy 127.0.0.1:1984
		}
	}

	# ── Aufzeichnung: NICHT im Gateway (go2rtc = nur Live; Surveillance Station + Aufnahmen der QNAP sind TABU) ──

	# ── Gesundheitsabruf fuer die App-Ansicht "Einrichtung" (nur "ok", kein Bild, kein go2rtc) ──────────
	handle /gesund {
		header Access-Control-Allow-Origin "https://epkolar.github.io"
		header Access-Control-Allow-Private-Network "true"
		header Vary "Origin"
		respond "ok" 200
	}

	# ── alles andere (go2rtc /api/*, Oberflaeche, Konfiguration, /aufzeichnung/*) ────────────────────────
	handle {
		respond 404
	}
}
