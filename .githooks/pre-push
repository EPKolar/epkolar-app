#!/bin/sh
# EPKolar pre-push-Tor - Logik in .githooks/pre_push.py (siehe dort). Aktivieren: git config core.hooksPath .githooks
top=$(git rev-parse --show-toplevel)
for py in python python3 py; do
  if command -v "$py" >/dev/null 2>&1; then
    exec "$py" "$top/.githooks/pre_push.py" "$@"
  fi
done
echo "EPK-PRE-PUSH: kein Python gefunden - Push abgelehnt (fail closed)" >&2
exit 1
